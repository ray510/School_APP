{
  "name": "@hk-school/web",
  "version": "0.1.0",
  "description": "香港年度選校資訊平台 - 前端",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.4.21", "vue-router": "^4.3.2", "pinia": "^2.1.7", "zod": "^3.22.4",
    "@hk-school/contracts": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4", "vite": "^5.1.0", "typescript": "5.6.2", "vue-tsc": "2.1.10",
    "@vue/test-utils": "^2.4.4", "vitest": "^1.2.2", "@playwright/test": "^1.42.1",
    "eslint": "8.57.1", "eslint-plugin-vue": "^9.22.0"
  }
}
